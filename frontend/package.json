{
  "name": "raven-ui",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=26.12.0"
  },
  "packageManager": "npm@11.20.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:dev": "vite build --minify false --mode development",
    "build": "vite build --mode production",
    "preview": "vite preview",
    "test": "node --import ./test.config.mjs --test tests/*.test.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@wailsio/runtime": "3.0.0-beta.29"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.8",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
