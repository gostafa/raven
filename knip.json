{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/*.mjs"]
    },
    "frontend": {
      "entry": ["src/features/*/index.ts!", "tests/*.test.mjs"],
      "project": ["src/**/*.{ts,svelte}!", "tooling/**/*.mjs", "tests/*.mjs"]
    }
  },
  "ignoreBinaries": ["task"]
}
