<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="raven"
        Arguments=""
        InstallLocation="C:\Program Files\Raven\Raven">
    </Installer>
    <PackageInformation
        PackageName="Raven"
        PackageDisplayName="Raven"
        PublisherName="CN=Raven"
        PublisherDisplayName="Raven"
        Version="0.1.0.0"
        PackageDescription="Raven desktop companion">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="app.raven.desktop"
                Description="Raven desktop companion"
                DisplayName="Raven"
                ExecutableName="raven"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Raven</DisplayName>
            <PublisherDisplayName>Raven</PublisherDisplayName>
            <Description>Raven desktop companion</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="raven.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
